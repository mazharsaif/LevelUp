# Python environment (regenerated with `uv sync` in the repo root)
.venv/
**/__pycache__/
*.pyc

# Learner progress, daily backups and bug reports (private user data; the server recreates users.json)
progress/

# Generated pronunciation audio (~48 MB, regenerate with tools/fetch_audio.py)
app/audio/

# macOS / editor cruft
.DS_Store
*.swp

# Old workspace material (job hunting, source PDFs, notes) moved to ../legacy; ignored in case it ever lands in the repo
legacy/

# Personal Claude Code settings (shared ones are in .claude/settings.json)
.claude/settings.local.json

# Android (TWA) build outputs; the signed APK that ships is app/download/levelup.apk
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/*.apk
android/*.idsig
