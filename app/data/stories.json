en?","en":"Hello! What would you like to drink?","a":"1d3f6f7de132","s":"26b406241745"},{"sp":"Anna","de":"Einen Kaffee, bitte.","en":"A coffee, please.","a":"f926d621862b","s":"4820e2915518"},{"sp":"Herr Müller","de":"Mit Milch und Zucker?","en":"With milk and sugar?","a":"0c4db63a55fc","s":"5fb181724145"},{"sp":"Anna","de":"Nur mit Milch, bitte. Und ein Stück Kuchen.","en":"Just with milk, please. And a piece of cake.","a":"e293955c8ee9","s":"a664984b370a"},{"sp":"Herr Müller","de":"Gern. Das macht 6,80 Euro.","en":"Certainly. That's €6.80.","a":"393d1d79464b","s":"60a1afca86f2"},{"sp":"Anna","de":"Hier sind sieben Euro. Stimmt so.","en":"Here are seven euros. Keep the change.","a":"221600b552a0","s":"e93893a09cce"},{"sp":"Herr Müller","de":"Danke schön!","en":"Thank you very much!","a":"7da06110c867","s":"9beb4bdd8a23"}],"q":[{"t":"mc","q":"What does Anna drink?","o":["Tea","Coffee","Water"],"a":1,"line":1},{"t":"tf","q":"She takes sugar.","a":false,"line":3},{"t":"mc","q":"How much is the bill?","o":["€6.80","€8.60","€7.00"],"a":0,"line":4},{"t":"mc","q":"How much does she give the waiter?","o":["€6","€7","€10"],"a":1,"line":5}]},{"id":"s08","title":"Die Wohnung","titleEn":"The flat","scene":"🏠","minWords":330,"pre":[{"de":"die Wohnung","en":"the flat","a":"9d94899e156d"},{"de":"das Zimmer","en":"the room","a":"525863cce052"},{"de":"unten","en":"downstairs","a":"624688500957"}],"lines":[{"sp":"Frau Klein","de":"Hier ist die Wohnung. Sie hat zwei Zimmer, eine Küche und ein Bad.","en":"Here's the flat. It has two rooms, a kitchen and a bathroom.","a":"f78c53dd5de8","s":"f86d72061de3"},{"sp":"Ravi","de":"Oh, die Küche ist schön und hell!","en":"Oh, the kitchen is nice and bright!","a":"ca04e5fc6fe0","s":"2eeda5f4ce76"},{"sp":"Ravi","de":"Wie hoch ist die Miete?","en":"How much is the rent?","a":"8fd424372b00","s":"65ca849b626f"},{"sp":"Frau Klein","de":"Achthundert Euro im Monat.","en":"Eight hundred euros a month.","a":"f597adce166b","s":"a00c2aa9d90b"},{"sp":"Ravi","de":"Gibt es einen Balkon?","en":"Is there a balcony?","a":"c8793e66367c","s":"41d10a9c4559"},{"sp":"Frau Klein","de":"Ja, der Balkon ist hier. Und unten ist ein Garten.","en":"Yes, the balcony is here. And downstairs there's a garden.","a":"da313ecf33a3","s":"a3497c8b4dfa"},{"sp":"Ravi","de":"Wunderbar. Ich nehme die Wohnung!","en":"Wonderful. I'll take the flat!","a":"a0010f8e26c1","s":"2161ec2cffbb"},{"sp":"Frau Klein","de":"Schön! Hier ist der Schlüssel.","en":"Lovely! Here's the key.","a":"f4894d42eb02","s":"b6e37ccd72db"}],"q":[{"t":"mc","q":"How many rooms does the flat have?","o":["One","Two","Three"],"a":1,"line":0},{"t":"mc","q":"What is the rent?","o":["€800 a month","€300 a month","€800 a week"],"a":0,"line":3},{"t":"mc","q":"What is downstairs?","o":["A garden","A café","A garage"],"a":0,"line":5},{"t":"tf","q":"Ravi takes the flat.","a":true,"line":6}]}]}