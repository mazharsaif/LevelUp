{"stories":[{"id":"s01","title":"Hallo, ich bin Ravi","titleEn":"Hello, I'm Ravi","scene":"👋","minWords":12,"pre":[{"de":"Bis morgen!","en":"See you tomorrow!","a":"c001bc084059"}],"lines":[{"sp":"Anna","de":"Hallo! Ich bin Anna.","en":"Hello! I'm Anna.","a":"34b727feb38d","s":"6484ac15e8c5"},{"sp":"Ravi","de":"Hallo, Anna! Ich heiße Ravi.","en":"Hello, Anna! My name is Ravi.","a":"ceb0b48841c3","s":"bf252809bdd7"},{"sp":"Anna","de":"Wie geht es dir, Ravi?","en":"How are you, Ravi?","a":"a21246e5a9cb","s":"4aef52373f31"},{"sp":"Ravi","de":"Gut, danke. Und dir?","en":"Good, thanks. And you?","a":"1d5220f5d8bf","s":"46957e164fc2"},{"sp":"Anna","de":"Sehr gut, danke!","en":"Very good, thanks!","a":"1aae7eaae479","s":"e7768fd76648"},{"sp":"Ravi","de":"Tschüss, Anna! Bis morgen!","en":"Bye, Anna! See you tomorrow!","a":"434cbd41da21","s":"10b1bac093ea"},{"sp":"Anna","de":"Tschüss, Ravi!","en":"Bye, Ravi!","a":"bb30e2bb8541","s":"e95f7176bf6d"}],"q":[{"t":"mc","q":"What is the man's name?","o":["Anna","Ravi","Tom"],"a":1,"line":1},{"t":"mc","q":"How is Ravi?","o":["Good","Not so good","Tired"],"a":0,"line":3},{"t":"tf","q":"Anna feels very good.","a":true,"line":4},{"t":"mc","q":"When will they see each other again?","o":["Tonight","Tomorrow","On Monday"],"a":1,"line":5}]},{"id":"s02","title":"Meine Nummer","titleEn":"My number","scene":"📞","minWords":24,"pre":[{"de":"die Nummer","en":"the number","a":"fd052cbe56be"},{"de":"Hier ist …","en":"… speaking (on the phone)","a":"aa2809987f98"}],"lines":[{"sp":"Ravi","de":"Hallo, hier ist Ravi.","en":"Hello, Ravi speaking.","a":"029b0d32d872","s":"2a1615e389e5"},{"sp":"Anna","de":"Hallo, Ravi!","en":"Hello, Ravi!","a":"c8ce2363d583","s":"8d35faa4a51a"},{"sp":"Ravi","de":"Anna, hast du meine Nummer?","en":"Anna, do you have my number?","a":"e1c52c8bf4a3","s":"a72185968bf9"},{"sp":"Anna","de":"Nein. Wie ist deine Nummer?","en":"No. What's your number?","a":"a6717b20d81d","s":"098f2102c1d4"},{"sp":"Ravi","de":"Null, eins, sieben, zwei, vier, acht, neun.","en":"0 1 7 2 4 8 9.","a":"48b70e46e63e","s":"49a3a8c906ad"},{"sp":"Anna","de":"Wie bitte? Langsam, bitte.","en":"Sorry? Slowly, please.","a":"b85e80f6a815","s":"da18fceac582"},{"sp":"Ravi","de":"Null – eins – sieben – zwei – vier – acht – neun.","en":"0 – 1 – 7 – 2 – 4 – 8 – 9.","a":"1274b20f04e2","s":"c2d546ff1366"},{"sp":"Anna","de":"Danke! Bis bald!","en":"Thanks! See you soon!","a":"a667170ddf31","s":"b638e8bc823f"}],"q":[{"t":"mc","q":"What does Anna need?","o":["Ravi's address","Ravi's phone number","Ravi's name"],"a":1,"line":3},{"t":"mc","q":"How does the number start?","o":["0 1 7 2","0 1 6 2","0 7 1 2"],"a":0,"line":4},{"t":"mc","q":"Why does Anna say 'Langsam, bitte'?","o":["Ravi speaks too fast","She is angry","She has to go"],"a":0,"line":5},{"t":"tf","q":"The number ends with 9.","a":true,"line":6}]},{"id":"s03","title":"Im Deutschkurs","titleEn":"In the German class","scene":"🏫","minWords":50,"pre":[{"de":"die Lehrerin","en":"the (female) teacher","a":"6f7e05c01e4d"},{"de":"Wie schreibt man das?","en":"How do you spell that?","a":"38b1ac0e123a"},{"de":"Woher kommen Sie?","en":"Where are you from?","a":"06eec31a8e00"}],"lines":[{"sp":"Frau Klein","de":"Guten Morgen! Ich bin Frau Klein, Ihre Lehrerin.","en":"Good morning! I'm Ms Klein, your teacher.","a":"dd2582f4eaa9","s":"9213dd3f7498"},{"sp":"Frau Klein","de":"Wie heißen Sie?","en":"What's your name?","a":"583113a87520","s":"0709e57255f5"},{"sp":"Ravi","de":"Ich heiße Ravi Sharma.","en":"My name is Ravi Sharma.","a":"624b492798a6","s":"07ee0813bc6c"},{"sp":"Frau Klein","de":"Wie bitte? Wie schreibt man das?","en":"Sorry? How do you spell that?","a":"e745b96e22f3","s":"5ea4639f4aab"},{"sp":"Ravi","de":"S – H – A – R – M – A.","en":"S – H – A – R – M – A.","a":"fe3e3d16c439","s":"db0e5c071cc8"},{"sp":"Frau Klein","de":"Danke. Woher kommen Sie, Herr Sharma?","en":"Thank you. Where are you from, Mr Sharma?","a":"9643725a932d","s":"8860fef3d742"},{"sp":"Ravi","de":"Ich komme aus Indien, aus Indore.","en":"I'm from India, from Indore.","a":"c4ed476e2d13","s":"80d253776822"},{"sp":"Frau Klein","de":"Willkommen in Frankfurt!","en":"Welcome to Frankfurt!","a":"46f968a34b8f","s":"64bd9d685ccb"}],"q":[{"t":"mc","q":"Who is Frau Klein?","o":["A teacher","A doctor","Ravi's sister"],"a":0,"line":0},{"t":"mc","q":"How does Ravi spell his family name?","o":["S-H-A-R-M-A","S-C-H-A-R-M-A","S-H-A-R-A-M"],"a":0,"line":4},{"t":"mc","q":"Where is Ravi from?","o":["Frankfurt","Indore, in India","Berlin"],"a":1,"line":6},{"t":"tf","q":"Frau Klein says 'du' to Ravi.","a":false,"line":1}]},{"id":"s04","title":"Das Formular","titleEn":"The form","scene":"📝","minWords":100,"pre":[{"de":"Wann sind Sie geboren?","en":"When were you born?","a":"de8798b5892e"},{"de":"ledig","en":"single (not married)","a":"9499278bdc08"}],"lines":[{"sp":"Herr Müller","de":"Guten Tag. Ihr Name, bitte?","en":"Good afternoon. Your name, please?","a":"560c8d6d475d","s":"c6eec2b607e0"},{"sp":"Ravi","de":"Sharma. Mein Vorname ist Ravi.","en":"Sharma. My first name is Ravi.","a":"f5a607ee13fa","s":"e9f4c33211dd"},{"sp":"Herr Müller","de":"Wann sind Sie geboren?","en":"When were you born?","a":"1158f3762015","s":"a52b6da8bd26"},{"sp":"Ravi","de":"Ich bin 1995 in Indore geboren.","en":"I was born in Indore in 1995.","a":"bc913f12c863","s":"e3f46d368fb9"},{"sp":"Herr Müller","de":"Sind Sie verheiratet?","en":"Are you married?","a":"4da405984c27","s":"5e105a5a65cf"},{"sp":"Ravi","de":"Nein, ich bin ledig.","en":"No, I'm single.","a":"87583ecb5f14","s":"a47584b58111"},{"sp":"Herr Müller","de":"Und Ihre Adresse?","en":"And your address?","a":"0402f0faebd6","s":"fe118f398c92"},{"sp":"Ravi","de":"Goethestraße 12, 60313 Frankfurt.","en":"Goethestraße 12, 60313 Frankfurt.","a":"77a9d762f068","s":"e5c5e7c7812b"},{"sp":"Herr Müller","de":"Danke. Bitte unterschreiben Sie hier.","en":"Thank you. Please sign here.","a":"4d5e1e5a5183","s":"34edf110ecdf"}],"q":[{"t":"mc","q":"What is happening?","o":["Ravi is filling in a form","Ravi is ordering food","Ravi is at the doctor's"],"a":0,"line":0},{"t":"mc","q":"When was Ravi born?","o":["1995","1985","1999"],"a":0,"line":3},{"t":"tf","q":"Ravi is married.","a":false,"line":5},{"t":"mc","q":"What is the house number?","o":["12","20","2"],"a":0,"line":7}]},{"id":"s05","title":"Am Wochenende","titleEn":"At the weekend","scene":"🎬","minWords":130,"pre":[{"de":"das Kino","en":"the cinema","a":"faac60e473fe"},{"de":"Kommst du mit?","en":"Are you coming along?","a":"2202a28b4f46"},{"de":"um halb acht","en":"at half past seven (7:30)","a":"bace0040ebe8"}],"lines":[{"sp":"Lena","de":"Ravi, was machst du am Wochenende?","en":"Ravi, what are you doing at the weekend?","a":"592261e15e4c","s":"738fe7320dfa"},{"sp":"Ravi","de":"Am Samstag arbeite ich. Am Sonntag habe ich frei.","en":"On Saturday I work. On Sunday I'm off.","a":"76fb46340ba8","s":"0353b7f54dd5"},{"sp":"Lena","de":"Super! Wir gehen am Sonntag ins Kino. Kommst du mit?","en":"Great! We're going to the cinema on Sunday. Are you coming along?","a":"a91814e681c5","s":"a90c805e0e2c"},{"sp":"Ravi","de":"Ja, gern! Wann beginnt der Film?","en":"Yes, gladly! When does the film start?","a":"8e937df6ff00","s":"ce58325b2472"},{"sp":"Lena","de":"Um halb acht. Wir treffen uns um sieben vor dem Kino.","en":"At half past seven. We'll meet at seven in front of the cinema.","a":"960d75f66302","s":"22f66a210633"},{"sp":"Ravi","de":"Gut. Bis Sonntag!","en":"Good. See you on Sunday!","a":"842dd6587111","s":"2405d0345b91"}],"q":[{"t":"mc","q":"What does Ravi do on Saturday?","o":["He works","He goes to the cinema","He visits his family"],"a":0,"line":1},{"t":"mc","q":"Where are they going on Sunday?","o":["To the cinema","To a café","To the park"],"a":0,"line":2},{"t":"mc","q":"When does the film start?","o":["7:00","7:30","8:30"],"a":1,"line":4},{"t":"mc","q":"When do they meet?","o":["7:00","7:30","6:30"],"a":0,"line":4}]},{"id":"s06","title":"Meine Familie","titleEn":"My family","scene":"👨‍