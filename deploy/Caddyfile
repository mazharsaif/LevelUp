# Caddy reverse proxy for the LevelUp droplet. Lives at /etc/caddy/Caddyfile.
# Caddy gets and renews HTTPS certificates (Let's Encrypt) for every site name below by itself.
# Apply changes:  sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Logs:           journalctl -u caddy -f
#
# New app = new block:  name.levelrise.org { reverse_proxy 127.0.0.1:<port> }
# (plus a DNS A record for "name" in Cloudflare)

# Shared settings for every app
(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# LevelUp, main site (from 11-20). The Android app (APK) opens this address too, so keep it stable.
# Cloudflare DNS: A "@" and A "www" -> 206.189.213.12 (DNS only, grey cloud).
levelrise.org {
	import common
	reverse_proxy 127.0.0.1:8000
}

# Every other name sends visitors to the main site, keeping the path (old APK, old links, bookmarks).
www.levelrise.org, level-up.com.de, dev.level-up.com.de, app.level-up.com.de {
	import common
	redir https://levelrise.org{uri} permanent
}

# StayLit: static clock that keeps the screen awake. Files: /var/www/staylit (synced by staylit-deploy).
# Cloudflare DNS: A "staylit" -> 206.189.213.12 (DNS only, grey cloud).
staylit.levelrise.org {
	import common
	root * /var/www/staylit
	file_server
	@sw path /sw.js
	header @sw Cache-Control "no-cache"
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"
}
